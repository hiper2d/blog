---
import Base from '../../layouts/Base.astro';

// The Cutting Room: production diaries generated by Simona from each project's work log.
// Each entry is a standalone page under /public/cutting-room/<slug>/ with its own design and
// media pack; this index is the only part rendered by Astro. Newest first.
const entries = [
  {
    slug: 'sleeper-3',
    title: 'Pod B-104 Cutting Room',
    project: 'Sleeper AI, episode three',
    date: '2026-09-18',
    dek: 'Fifty-four seconds of film in three days: the opening made three times, a number on a screen six ways, twenty-two takes of "Boo", and the two bugs only a measurement could catch.',
    cover: '/cutting-room/sleeper-3/cover-26s.jpg',
    stats: '54 s · 9 scenes · $22.38',
  },
  {
    slug: 'recruit',
    title: 'Cutting Room Diary',
    project: 'This One Is Not For You, a recruitment short',
    date: '2026-09-13',
    dek: 'Thirty-four voice takes of one line, three plates that died for three different reasons, borrowed footage in a vertical frame, and the silence you cannot hear.',
    cover: '/cutting-room/recruit/02-scene1/02-closeup-NO-finger.jpg',
    stats: '34 s · 5 scenes · $6.63',
  },
];
---

<Base title="Cutting Room" description="Production diaries for the AI films: every take, kept and killed, generated from the work logs by Simona.">
  <h1>Cutting Room</h1>
  <p class="cr-intro">
    Production diaries for the short films. Every one is written by
    <a href="https://github.com/hiper2d/simona-ai-computer-operator">Simona</a>, my AI pair partner,
    from the work log she keeps while we make the thing: every plate and clip that was tried, the
    verdict on each, the voice takes you can play, and what it all cost. I approve the takes; she
    writes the record. They have their own formatting because they are a different kind of document
    from the posts.
  </p>
  <ul class="cr-list">
    {entries.map((e) => (
      <li class="cr-item">
        <a class="cr-cover" href={`/cutting-room/${e.slug}/`}>
          <img src={e.cover} alt="" loading="lazy" />
        </a>
        <div class="cr-body">
          <p class="cr-project">{e.project}</p>
          <h2><a href={`/cutting-room/${e.slug}/`}>{e.title}</a></h2>
          <p class="cr-dek">{e.dek}</p>
          <p class="cr-meta"><time datetime={e.date}>{e.date}</time> · {e.stats}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .cr-intro { max-width: 62ch; opacity: .85; }
  .cr-list { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 2.2rem; }
  .cr-item { display: grid; grid-template-columns: 150px 1fr; gap: 1.4rem; align-items: start; }
  .cr-cover img { width: 150px; aspect-ratio: 9 / 16; object-fit: cover; display: block; border-radius: 3px; }
  .cr-project { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; opacity: .6; margin: 0 0 .3rem; }
  .cr-body h2 { margin: 0 0 .5rem; font-size: 1.35rem; line-height: 1.2; }
  .cr-dek { margin: 0 0 .5rem; max-width: 60ch; }
  .cr-meta { font-size: .85rem; opacity: .65; margin: 0; font-variant-numeric: tabular-nums; }
  @media (max-width: 520px) {
    .cr-item { grid-template-columns: 1fr; }
    .cr-cover img { width: 100%; max-width: 220px; aspect-ratio: 9 / 16; }
  }
</style>
