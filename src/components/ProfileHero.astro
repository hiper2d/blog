---
---

<header class="about-hero">
  <div class="about-hero__banner" role="img" aria-label="A dim workspace with a glowing code editor on a monitor, a desk lamp, and a steaming mug."></div>
  <a class="about-hero__photo-link" href="/images/profile.jpg" aria-label="View profile photo full size">
    <span class="about-hero__photo" role="img" aria-label="Aliaksei Zelianouski"></span>
  </a>
  <div class="about-hero__text">
    <h1>Aliaksei Zelianouski</h1>
    <p class="about-hero__tagline">Alex, if you prefer. Building agents and apps with AI for fun, not business.</p>
  </div>
</header>

<dialog id="profile-dialog" class="photo-dialog" aria-label="Profile photo full size">
  <img src="/images/profile.jpg" alt="Aliaksei Zelianouski" />
</dialog>

<style>
  .about-hero {
    margin: 0 0 2.5rem;
  }
  .about-hero__banner {
    width: 100%;
    aspect-ratio: 4 / 1;
    background-image: url('/images/about-banner.jpg');
    background-size: cover;
    background-position: right center;
    border-radius: 6px;
  }
  .about-hero__photo-link {
    display: block;
    width: fit-content;
    margin: -68px 0 0 2rem;
    cursor: zoom-in;
    line-height: 0;
  }
  .about-hero__photo {
    display: block;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background-image: url('/images/profile.jpg');
    background-size: cover;
    background-position: center top;
    background-color: var(--bg, #ffffff);
    border: 4px solid var(--bg, #ffffff);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }
  .about-hero__text {
    margin: 1rem 0 0 2rem;
  }
  .about-hero__text :global(h1) {
    margin: 0 0 0.35rem;
    line-height: 1.15;
  }
  .about-hero__tagline {
    margin: 0;
    color: var(--fg-faint, #888);
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .photo-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 90vw;
    max-height: 90vh;
    overflow: visible;
  }
  .photo-dialog::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }
  .photo-dialog :global(img) {
    display: block;
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    cursor: zoom-out;
    border-radius: 4px;
  }

  @media (max-width: 520px) {
    .about-hero__photo-link {
      margin: -48px 0 0 1rem;
    }
    .about-hero__photo {
      width: 100px;
      height: 100px;
    }
    .about-hero__text {
      margin: 0.75rem 0 0 1rem;
    }
  }
</style>

<script is:inline>
  (function () {
    const link = document.querySelector('.about-hero__photo-link');
    const dialog = document.getElementById('profile-dialog');
    if (!link || !dialog) return;
    link.addEventListener('click', (e) => {
      e.preventDefault();
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        window.open(link.getAttribute('href'), '_blank');
      }
    });
    dialog.addEventListener('click', () => dialog.close());
  })();
</script>
